
{
  "name": "Learning-Langchain",
  "containerEnv": {
    "HF_HOME": "${containerWorkspaceFolder}/.cache/huggingface"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv312/bin/python",
        "python.terminal.useEnvFile": true
      }
    }
  }
}
